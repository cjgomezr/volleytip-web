{
  "name": "volleytip-web",
  "version": "0.1.0",
  "private": true,
  "description": "volleytip.com: sitio público, tienda (física y digital), camps, VBall Tour y admin.",
  "scripts": {
    "dev": "react-router dev --port 3740 --strictPort",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "prepare": "react-router typegen",
    "test": "vitest run",
    "test:kit": "vitest run --config vitest.kit.config.mts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "react-router typegen && tsc --noEmit",
    "e2e": "playwright test",
    "ui:screenshots": "node --experimental-strip-types scripts/capture-ui.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.50.0",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "js-yaml": "^4.1.0",
    "postgres": "4.1.1",
    "prettier": "^3.3.0",
    "supabase": "3.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
