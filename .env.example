# Variables de entorno del servidor. Las valida src/lib/env.server.ts: si
# falta alguna, el servidor no arranca.
#
# Para trabajar en local: copia este archivo como .env.local y llena los
# valores. Git ignora .env.local; nunca lo subas. Aquí solo van nombres.
# De dónde sale cada valor en cada entorno: docs/entornos.md.

# Nombre del entorno: local, test, staging o production.
APP_ENV=

# URL del proyecto de Supabase. En local es la "API URL" que imprime
# `npx supabase status` con la base local arriba (npm run db:start).
SUPABASE_URL=

# Llave pública ("publishable"). Respeta RLS.
SUPABASE_ANON_KEY=

# Llave de servicio ("secret"). Salta RLS: solo vive en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Captcha
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
FORM_PROTECTION_SECRET=
CLIENT_IP_HEADER=
CLIENT_IP_TRUSTED_HOPS=
IMAGE_CDN_HOST=
SITE_ORIGIN=
# Videos (Bunny Stream). Se obtienen en el panel de Bunny, Stream, la
# librería, sección API. Local y staging usan la librería de pruebas;
# producción usa la real. Ver docs/entornos.md.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST=
# Opcional: con "true" la entrada del panel ofrece Google (docs/entornos.md).
GOOGLE_SIGN_IN_ENABLED=
